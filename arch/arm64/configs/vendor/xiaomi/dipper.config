CONFIG_BCM_GPS_SPI_DRIVER=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_FP_VREG_CONTROL=y
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_LEDS_LM3644=y
CONFIG_MACH_XIAOMI=y
CONFIG_MACH_XIAOMI_E1N=y
CONFIG_MACH_XIAOMI_SDM845=y
CONFIG_SECURE_TOUCH=y
CONFIG_TOUCHSCREEN_ATMEL_MXT=y
CONFIG_TOUCHSCREEN_ST_FTS_V521=y
CONFIG_USE_ROHM_BU64753=y
CONFIG_FINGERPRINT_FPC_SCREEN_NOTIFY=y
CONFIG_I2C_BY_DMA=y
# CONFIG_TOUCHSCREEN_ATMEL_MXT_T37 is not set
# CONFIG_TOUCHSCREEN_ST_DEBUG_FS is not set

#
# KernelSU
#
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
CONFIG_KSU_ALLOWLIST_WORKAROUND=y
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
CONFIG_KPM=y

#
# KernelSU - SUSFS
#
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
